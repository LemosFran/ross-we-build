        "selector": "JSXOpeningElement[name.name='SiteFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:statement|ctaLabel|ctaHref|address|phone|legal|links|socials|style|key|ref|className|style|children)$/]",
