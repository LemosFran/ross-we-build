        "message": "<InfoBlock> tone must be one of 'ink' | 'onInk'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MediaCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|excerpt|linkLabel|href|image|imageAlt|height|panelTone|style|key|ref|className|style|children)$/]",
        "message": "<MediaCard> doesn't accept that prop. Declared props: title, excerpt, linkLabel, href, image, imageAlt, height, panelTone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MediaCard'] > JSXAttribute[name.name='panelTone'] > Literal[value!=/^(?:mint|ink|paper)$/]",
        "message": "<MediaCard> panelTone must be one of 'mint' | 'ink' | 'paper'."
