{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/core/**",
              "components/layout/**",
              "components/navigation/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:TT Octosquares|Red Hat Display|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: TT Octosquares, Red Hat Display, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|size|tone|style|key|ref|className|style|children)$/]",
        "message": "<ArrowLink> doesn't accept that prop. Declared props: children, href, size, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowLink'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<ArrowLink> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowLink'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|onInk|accent)$/]",
        "message": "<ArrowLink> tone must be one of 'ink' | 'onInk' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandGlyph'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|style|key|ref|className|style|children)$/]",
        "message": "<BrandGlyph> doesn't accept that prop. Declared props: name, size, strokeWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandGlyph'] > JSXAttribute[name.name='name'] > Literal[value!=/^(?:close|arrow-corner|arrow-left|arrow-right)$/]",
        "message": "<BrandGlyph> name must be one of 'close' | 'arrow-corner' | 'arrow-left' | 'arrow-right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|cut|disabled|href|as|iconEnd|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, cut, disabled, href, as, iconEnd, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|outline|outlineOnInk|ghost)$/]",
        "message": "<Button> variant must be one of 'solid' | 'outline' | 'outlineOnInk' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ClipPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|corners|cut|bordered|style|key|ref|className|style|children)$/]",
        "message": "<ClipPanel> doesn't accept that prop. Declared props: children, tone, corners, cut, bordered, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ClipPanel'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:mint|ink|paper|accent)$/]",
        "message": "<ClipPanel> tone must be one of 'mint' | 'ink' | 'paper' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CornerClose'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|label|onClick|style|key|ref|className|style|children)$/]",
        "message": "<CornerClose> doesn't accept that prop. Declared props: size, label, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DiagonalStripes'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|width|gap|angle|style|key|ref|className|style|children)$/]",
        "message": "<DiagonalStripes> doesn't accept that prop. Declared props: color, width, gap, angle, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|as|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, tone, as, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|accentOnInk|ink|onInk)$/]",
        "message": "<Eyebrow> tone must be one of 'accent' | 'accentOnInk' | 'ink' | 'onInk'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|body|image|imageAlt|linkLabel|href|onClick|tone|cut|corner|fit|reverse|minHeight|style|key|ref|className|style|children)$/]",
        "message": "<FeatureRow> doesn't accept that prop. Declared props: eyebrow, title, body, image, imageAlt, linkLabel, href, onClick, tone, cut, corner, fit, reverse, minHeight, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureRow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:mint|paper|sunken)$/]",
        "message": "<FeatureRow> tone must be one of 'mint' | 'paper' | 'sunken'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureRow'] > JSXAttribute[name.name='corner'] > Literal[value!=/^(?:bl|tr|tl|br)$/]",
        "message": "<FeatureRow> corner must be one of 'bl' | 'tr' | 'tl' | 'br'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureRow'] > JSXAttribute[name.name='fit'] > Literal[value!=/^(?:contain|cover)$/]",
        "message": "<FeatureRow> fit must be one of 'contain' | 'cover'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Heading'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|size|as|tone|align|maxWidth|style|key|ref|className|style|children)$/]",
        "message": "<Heading> doesn't accept that prop. Declared props: children, size, as, tone, align, maxWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Heading'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:xl|lg|md|sm)$/]",
        "message": "<Heading> size must be one of 'xl' | 'lg' | 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Heading'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:h1|h2|h3|h4|div)$/]",
        "message": "<Heading> as must be one of 'h1' | 'h2' | 'h3' | 'h4' | 'div'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Heading'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|onInk|accent)$/]",
        "message": "<Heading> tone must be one of 'ink' | 'onInk' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Heading'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<Heading> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HexButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:direction|size|label|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<HexButton> doesn't accept that prop. Declared props: direction, size, label, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HexButton'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:prev|next)$/]",
        "message": "<HexButton> direction must be one of 'prev' | 'next'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='InfoBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|lines|tone|style|key|ref|className|style|children)$/]",
        "message": "<InfoBlock> doesn't accept that prop. Declared props: label, lines, tone, style."
      },
      {
